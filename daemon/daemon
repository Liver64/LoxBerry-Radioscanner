#!/bin/bash

# Create/update rtl_433 configuration synchronously so we can evaluate
# the real exit code of create_conf.php.
/usr/bin/php -q REPLACELBPBINDIR/create_conf.php >/dev/null 2>&1
exitcode=$?

if [ "$exitcode" -ne 0 ]; then
    exit "$exitcode"
fi

# Ensure the rtl_433 service is running.
if ! systemctl is-active --quiet rtl_433-mqtt.service; then
    systemctl restart rtl_433-mqtt.service || exit 1
    sleep 5
    systemctl is-active --quiet rtl_433-mqtt.service || exit 1
fi

exit 0
